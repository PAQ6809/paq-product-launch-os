# PAQ Product Launch OS environment example
#
# Phase 9 is still demo/mock-first. The app can build and run without these
# values. Add real values only in .env.local or in Vercel Environment Variables.

# Future OpenAI integration
OPENAI_API_KEY=
OPENAI_MODEL=

# Future Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional app metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
