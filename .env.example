# PAQ Product Launch OS environment example
#
# Phase 9 is still demo/mock-first. The app can build and run without these
# values. Add real values only in .env.local or in Vercel Environment Variables.

# v0.3 AI provider selection: mock | openai | nvidia
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m2.7
NVIDIA_MAX_TOKENS=4096
NVIDIA_TIMEOUT_MS=150000

# v0.4.6 AI Help Center. Production public demos stay mock unless explicitly enabled.
HELP_AI_PROVIDER=mock
ENABLE_PUBLIC_HELP_AI=false
HELP_RATE_LIMIT_ENABLED=true
HELP_RATE_LIMIT_WINDOW_SECONDS=3600
HELP_RATE_LIMIT_MAX_REQUESTS=20
HELP_MAX_MESSAGES_PER_THREAD=20

# Public API safety. Keep real AI and developer diagnostics disabled on public production demos by default.
ENABLE_PUBLIC_REAL_AI=false
REAL_AI_REQUIRE_LOGIN=true
REAL_AI_RATE_LIMIT_ENABLED=true
REAL_AI_RATE_LIMIT_WINDOW_SECONDS=3600
REAL_AI_RATE_LIMIT_MAX_REQUESTS=5
ENABLE_DEV_DIAGNOSTICS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=5

# v0.3.6 localization and report translation
TRANSLATION_PROVIDER=mock
ENABLE_DEV_TRANSLATION_TOOLS=false
DEFAULT_LOCALE=zh-TW
SUPPORTED_LOCALES=zh-TW,en,ja,ko,es,fr,de,vi,th,id,ar,he

# v0.4 Supabase Auth + workspace persistence
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 新專案建議使用 publishable key；舊專案可保留 anon key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Do not expose this value in client code; v0.4 app routes do not require it by default.
SUPABASE_SERVICE_ROLE_KEY=

# v0.4.5 security, encryption, compliance, and export controls
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=v1
REQUIRE_ENCRYPTION_IN_PRODUCTION=true
EXPORT_RETENTION_HOURS=24
ENABLE_EXPORT_AUDIT_LOG=true
ENABLE_DATA_EXPORT=true
ENABLE_ACCOUNT_DELETE_REQUEST=true

# Optional app metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
